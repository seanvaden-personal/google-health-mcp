{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-health-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables/secrets set in the Cloudflare dashboard across Git deploys.
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "migrations": [
    {
      "new_sqlite_classes": ["GoogleHealthMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GoogleHealthMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Replace with the id printed by: wrangler kv namespace create OAUTH_KV
      "id": "554d5f09bbf64f41acdf25eb8f90b3df"
    },
    {
      // Caches immutable past-day API responses. Created via:
      //   wrangler kv namespace create HEALTH_CACHE
      "binding": "HEALTH_CACHE",
      "id": "6e63feb56f394724ad8ebce4971af502"
    }
  ],
  "vars": {
    // Default Health API scopes requested from Google (read-only recovery data).
    // ecg/irn cover get_cardiac_events; remove them here if you don't want to
    // grant those, and that tool will simply return a permission error.
    "GOOGLE_OAUTH_SCOPES": "https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly https://www.googleapis.com/auth/googlehealth.nutrition.readonly",
    // Public origin of this Worker; used for the connector icon/website advertised to MCP clients.
    "PUBLIC_URL": "https://google-health-mcp.seanvaden.workers.dev",
    // IANA timezone used to resolve "today"/"last night" for date defaults.
    "TIME_ZONE": "America/New_York",
    // Exact redirect URIs MCP clients may use (Claude's connector callbacks).
    "ALLOWED_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback"
  }
  // Secrets (set via `wrangler secret put`):
  //   GOOGLE_CLIENT_ID
  //   GOOGLE_CLIENT_SECRET
  //   COOKIE_ENCRYPTION_KEY   (any long random string)
  //   ALLOWED_EMAILS          (your Google account email; kept as a secret so
  //                            it isn't committed to your fork)
  //   PELOTON_USERNAME        (optional; enables get_peloton_rides)
  //   PELOTON_PASSWORD        (optional)
}
